From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: trace QTVR rollover transitions

Record each actual QTVR hotspot transition and whether a rollover callback is
installed.  This distinguishes hotspot-map detection failures from failures in
the title's caption field without changing event dispatch or navigation.
---
 engines/director/lingo/xlibs/q/qtvr.cpp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/engines/director/lingo/xlibs/q/qtvr.cpp b/engines/director/lingo/xlibs/q/qtvr.cpp
--- a/engines/director/lingo/xlibs/q/qtvr.cpp
+++ b/engines/director/lingo/xlibs/q/qtvr.cpp
@@ -279,7 +279,14 @@ void QTVR::m_mouseOver(int nargs) {
 
 			me->_widget->processEvent(event);
 
-			if (hotspot != me->_video->getRolloverHotspotID() && !me->_rolloverCallbackMethod.empty()) {
+			const int rolloverHotspot = me->_video->getRolloverHotspotID();
+			if (hotspot != rolloverHotspot) {
+				warning("TNG-QTVR-HOVER old=%d new=%d mouse=%d,%d callback=%d",
+						hotspot, rolloverHotspot, event.mouse.x, event.mouse.y,
+						!me->_rolloverCallbackMethod.empty());
+			}
+
+			if (hotspot != rolloverHotspot && !me->_rolloverCallbackMethod.empty()) {
 				g_lingo->push(me->_rolloverCallbackObject);
 				g_lingo->push(me->_video->getRolloverHotspotID());
 
