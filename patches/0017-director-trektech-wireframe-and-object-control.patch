From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: clean Trek Tech transit wireframe and QTVR object drag

Trek Tech releases its shared direct-to-stage wireframe by unpuppeting
sprite 19.  Restore that channel from the current score before the existing
full redraw so the redraw cannot paint the released video's final frame.
This is restricted to Trek Tech's wireframe channel.

QTVR object dragging currently uses C++ remainder arithmetic directly when
wrapping columns.  A drag across column zero therefore produces a negative
column, rejects the movement, and leaves its delta to accumulate until a
later reversal causes a large jump.  Row-boundary movement accumulates for
the same reason.  Normalize the wrapped column and consume each axis once it
crosses the movement threshold.  Panorama navigation is unchanged.
---
 engines/director/lingo/lingo-builtins.cpp |  7 +++++++
 video/qtvr_decoder.cpp                    | 26 ++++++++++++++------------
 2 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/engines/director/lingo/lingo-builtins.cpp b/engines/director/lingo/lingo-builtins.cpp
--- a/engines/director/lingo/lingo-builtins.cpp
+++ b/engines/director/lingo/lingo-builtins.cpp
@@ -3305,6 +3305,8 @@ void LB::b_puppetSprite(int nargs) {
 			if (target->_puppet != val) {
 				Channel *channel = sc->getChannelById(spriteId);
 				bool releasingDirectToStageVideo = !val && channel->isVideoDirectToStage();
+				bool releasingTrekWireframe = releasingDirectToStageVideo && spriteId == 19 &&
+						Common::String(g_director->getGameId()).equals("trektech");
 				target->_puppet = val;
 				// Releasing a puppet sprite must redraw both its old area and the
 				// score sprite underneath it. Otherwise direct-to-stage video can
@@ -3312,6 +3314,11 @@ void LB::b_puppetSprite(int nargs) {
 				// leave its final frame behind until some unrelated redraw.
 				channel->setDirty();
 				channel->setNeedsDraw();
+				// Trek Tech uses sprite 19 for every transit wireframe. Restore its
+				// score state before requesting the full redraw; otherwise reset()
+				// redraws the just-released video's final frame one more time.
+				if (releasingTrekWireframe)
+					channel->setClean(sc->_currentFrame->_sprites[spriteId]);
 				if (releasingDirectToStageVideo)
 					g_director->getCurrentWindow()->reset();
 			}
diff --git a/video/qtvr_decoder.cpp b/video/qtvr_decoder.cpp
--- a/video/qtvr_decoder.cpp
+++ b/video/qtvr_decoder.cpp
@@ -1547,32 +1547,34 @@ void QuickTimeDecoder::handleObjectMouseMove(int16 x, int16 y) {
 	float speedX = (float)mouseDeltaX * speedFactor;
 	float speedY = (float)mouseDeltaY * speedFactor;
 
-	bool changed = false;
-
 	if (ABS(mouseDeltaY) >= sensitivity) {
 		int newFrame = track->getCurFrame() - round(speedY) * _nav.columns;
 
-		if (newFrame >= 0 && newFrame < track->getFrameCount()) {
+		if (newFrame >= 0 && newFrame < track->getFrameCount())
 			track->setCurFrame(newFrame);
-			changed = true;
-		}
+
+		// Consume this axis even at the first or last row. Otherwise the
+		// rejected distance accumulates and the object jumps when direction
+		// changes.
+		_prevMouse.y = y;
 	}
 
 	if (ABS(mouseDeltaX) >= sensitivity) {
 		int currentRow = track->getCurFrame() / _nav.columns;
 		int currentRowStart = currentRow * _nav.columns;
+		int currentColumn = track->getCurFrame() - currentRowStart;
+		int newColumn = (currentColumn - (int)roundf(speedX)) % _nav.columns;
+		if (newColumn < 0)
+			newColumn += _nav.columns;
 
-		int newFrame = (track->getCurFrame() - (int)roundf(speedX) - currentRowStart) % _nav.columns + currentRowStart;
+		int newFrame = currentRowStart + newColumn;
 
-		if (newFrame >= 0 && newFrame < track->getFrameCount()) {
+		if (newFrame >= 0 && newFrame < track->getFrameCount())
 			track->setCurFrame(newFrame);
-			changed = true;
-		}
-	}
 
-	if (changed) {
+		// Horizontal object movies wrap. Always consume the movement so a
+		// later reversal cannot replay a large, stale delta.
 		_prevMouse.x = x;
-		_prevMouse.y = y;
 	}
 }
 
