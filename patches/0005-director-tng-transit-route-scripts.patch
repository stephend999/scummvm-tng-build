From: TNG Technical Manual compatibility investigation
Subject: [PATCH 5/5] DIRECTOR: Run TNG transit route scripts on frame entry

The Windows TNG Technical Manual uses three scopeless score scripts to start
and wait for its short wireframe route movies. Label jumps can skip the normal
exitFrame dispatch for these frames, omitting the start/end location dots.
Run only those title-specific scripts when their frames are entered and mark
the exit handler complete to avoid duplicate dispatch.
---
 engines/director/score.cpp | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/engines/director/score.cpp b/engines/director/score.cpp
index a7641db0..6d17796d 100644
--- a/engines/director/score.cpp
+++ b/engines/director/score.cpp
@@ -833,6 +833,24 @@ void Score::update() {
 	if (_window->frozenLingoStateCount() > count)
 		return;
 
+	// The TNG Technical Manual uses three scopeless score scripts to start
+	// and wait for the short wireframe route movies around a corridor transit.
+	// Director 4 runs these scripts as the frame is visited. They can otherwise
+	// be skipped here when the surrounding handlers jump between labelled
+	// frames, which leaves the fly-through without its start/end location dots.
+	// Execute only these title-specific scripts on entry and mark exitFrame as
+	// handled so they are not run a second time when the frame advances.
+	if (Common::String(g_director->getGameId()).equals("trektech")) {
+		const uint16 actionId = _currentFrame->_mainChannels.actionId.member;
+		if (actionId == 1259 || actionId == 1260 || actionId == 1264) {
+			count = _window->frozenLingoStateCount();
+			_movie->processEvent(kEventExitFrame);
+			_exitFrameCalled = true;
+			if (_window->frozenLingoStateCount() > count)
+				return;
+		}
+	}
+
 	// then execute any immediate scripts, i.e. handlers attached to sprites
 	count = _window->frozenLingoStateCount();
 	_lingo->executeImmediateScripts(_currentFrame);
