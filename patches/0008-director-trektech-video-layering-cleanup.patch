@@ -182,19 +182,53 @@ void Window::renderChannel(Channel *channel, const Common::Rect &rect, Graphics:
 	Common::Array<Channel *> appendix;
 	Common::Rect r = rect;
 	r.clip(blitTo->getBounds());
+	bool isTrekTech = strcmp(g_director->getGameId(), "trektech") == 0;
+	Channel *trekDetailVideo = isTrekTech ? score->getChannelById(23) : nullptr;
 	size_t idx = 0;
-	// move direct-to-stage layers to the end of the list
+	// Direct-to-stage video normally bypasses Director's compositing and appears
+	// above the score. Trek Tech deliberately puts its enlarge/reduce controls
+	// above its shared detail/transit video on sprite 23, so keep only that video
