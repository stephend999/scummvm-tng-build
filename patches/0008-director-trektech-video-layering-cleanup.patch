diff --git a/engines/director/lingo/xlibs/q/qtvr.cpp b/engines/director/lingo/xlibs/q/qtvr.cpp
index f5e2c1cb..3cc2bb89 100644
--- a/engines/director/lingo/xlibs/q/qtvr.cpp
+++ b/engines/director/lingo/xlibs/q/qtvr.cpp
@@ -332,10 +332,15 @@ void QTVR::m_openMovie(int nargs) {
 		return;
 	}
 
+	// A single QTVR XObject can be reused for several locations. Dispose the
+	// previous widget and decoder before replacing them, otherwise the old widget
+	// remains registered with the window manager and can be drawn over the page.
+	me->close();
 	me->_video = new Video::QuickTimeDecoder();
 	debugC(5, kDebugXObj, "QtvrxtraXtra::m_QTVROpen(): Loading QT file ('%s')", path.toString().c_str());
 	if (!me->_video->loadFile(path)) {
 		Common::String error = Common::String::format("Error: Failed to load movie file ('%s')!", path.toString().c_str());
+		me->close();
 		g_lingo->push(error);
 		return;
 	}
diff --git a/engines/director/window.cpp b/engines/director/window.cpp
