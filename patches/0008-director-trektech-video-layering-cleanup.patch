+		if (enlargedView && detailImage && trekDetailVideo && trekDetailVideo->_movieRate == 0.0 &&
+				trekDetailVideo->isActiveVideo() && trekDetailVideo->isVideoDirectToStage()) {
+			size_t imageIdx = dirtyChannels.size();
+			size_t videoIdx = dirtyChannels.size();
+			for (size_t i = 0; i < dirtyChannels.size(); i++) {
+				if (dirtyChannels[i] == detailImage)
+					imageIdx = i;
+				else if (dirtyChannels[i] == trekDetailVideo)
+					videoIdx = i;
+			}
+			if (imageIdx < dirtyChannels.size() && videoIdx < dirtyChannels.size() &&
+					videoIdx > imageIdx) {
+				dirtyChannels.remove_at(videoIdx);
+				dirtyChannels.insert_at(imageIdx, trekDetailVideo);
+			}
+		}
 	}
 
