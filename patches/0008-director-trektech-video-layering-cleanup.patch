+	// normal direct-to-stage ordering.
 	while (idx < dirtyChannels.size()) {
 		Channel *ch = dirtyChannels[idx];
-		if (ch->isActiveVideo() && ch->isVideoDirectToStage()) {
+		if (ch->isActiveVideo() && ch->isVideoDirectToStage() && ch != trekDetailVideo) {
 			appendix.push_back(ch);
 			dirtyChannels.remove_at(idx);
 			continue;
 		}
 		idx++;
 	}
-	for (auto &it : appendix) {
+	for (auto &it : appendix)
 		dirtyChannels.push_back(it);
+
+	if (isTrekTech) {
+		// Trek Tech's detail view uses sprite 23 for the QuickTime item and
+		// sprite 22 for the enlarged still. The original projector hides the
+		// paused movie behind that still; keeping ordinary score order would
