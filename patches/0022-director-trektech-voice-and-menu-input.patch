From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: fix Trek Tech voice shortcut and menu rows

Trek Tech's QTVR widget consumes keyboard events before Movie can see them,
which made the voice-only shortcut unreachable on the title's normal screens.
Handle the title-specific shortcut before the window manager, suppress key
repeats, and update the title's existing audio globals without re-entering a
Lingo handler.

The title also stamps its element and parallel bars onto the stage and uses a
global coordinate-zone handler for the full rows.  Decorative sprites over the
labels must not make mouseCast report a cast member or the authored handler is
skipped.  For Trek Tech only, make mouseCast select mouse-responsive sprites;
this preserves real buttons while restoring full-row clicks on all menus.
---
 engines/director/events.cpp          | 60 +++++++++++++++++++++---------------
 engines/director/lingo/lingo-the.cpp |  7 ++++-
 2 files changed, 42 insertions(+), 25 deletions(-)

diff --git a/engines/director/events.cpp b/engines/director/events.cpp
--- a/engines/director/events.cpp
+++ b/engines/director/events.cpp
@@ -61,6 +61,39 @@ bool DirectorEngine::processSysEvents(bool captureClick, bool skipWindowManager)
 
 	Common::Event event;
 	while (pollEvent(event)) {
+		// Trek Tech's QTVR widget consumes all keyboard events before the movie
+		// can see them.  Handle the title's voice-only easter egg here, ahead
+		// of the window manager, so it also works while a panorama is active.
+		if (Common::String(getGameId()).equals("trektech") &&
+				event.type == Common::EVENT_KEYDOWN && !event.kbdRepeat &&
+				event.kbd.keycode == Common::KEYCODE_v &&
+				(event.kbd.flags & (Common::KBD_CTRL | Common::KBD_SHIFT)) ==
+						(Common::KBD_CTRL | Common::KBD_SHIFT) &&
+				g_lingo && g_lingo->_globalvars.contains("gVoiceEnable") &&
+				g_lingo->_globalvars.contains("gSoundEnable")) {
+			const bool voiceOnly = g_lingo->_globalvars["gVoiceEnable"].asInt() &&
+					!g_lingo->_globalvars["gSoundEnable"].asInt();
+			Window *window = getCurrentWindow();
+
+			g_lingo->_globalvars["gVoiceEnable"] = Datum(1);
+			g_lingo->_globalvars["gSoundEnable"] = Datum(voiceOnly ? 1 : 0);
+			if (g_lingo->_globalvars.contains("gSoundSetting"))
+				g_lingo->_globalvars["gSoundSetting"] = Datum(1);
+
+			if (!voiceOnly) {
+				if (window && window->getSoundManager()) {
+					window->getSoundManager()->stopSound(1);
+					window->getSoundManager()->stopSound(2);
+				}
+				g_system->displayMessageOnOSD(Common::U32String("Voice Only: ON"));
+			} else {
+				if (window && window->getCurrentMovie() && window->getCurrentMovie()->getScore())
+					window->getCurrentMovie()->getScore()->playSoundChannel(false);
+				g_system->displayMessageOnOSD(Common::U32String("Voice Only: OFF"));
+			}
+			continue;
+		}
+
 		if (Director::DT::isMouseInputIgnored()) {
 			if (Common::isMouseEvent(event)) {
 				if (event.type == Common::EVENT_LBUTTONDOWN) {
