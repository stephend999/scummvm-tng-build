From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: correct Trek Tech Index height and Help rendering

IndexMaker reads the BltIndex Window textHeight while constructing the Index,
before the title sets its Index-active globals. Identify that exact cast member
and return its complete rendered row height instead of interline spacing.

The Help explanation widget is wider than its authored score sprite. Extend
only that widget's render rectangle; do not alter Channel::getBbox(), because
that geometry also controls hit testing, sprite intersections, dirty-region
cleanup, and later interface and transit lifecycles.
---
 engines/director/castmember/text.cpp | 15 +++++++++++++++
 engines/director/window.cpp          | 16 ++++++++++++++++
 2 files changed, 31 insertions(+)

diff --git a/engines/director/castmember/text.cpp b/engines/director/castmember/text.cpp
--- a/engines/director/castmember/text.cpp
+++ b/engines/director/castmember/text.cpp
@@ -455,10 +455,25 @@ int TextCastMember::getLineHeight(int line) {
 
 // D4 dictionary book said this is line spacing
 int TextCastMember::getTextHeight() {
+	CastMemberInfo *castInfo = _cast->getCastMemberInfo(_castId);
+	const bool trekIndexField = Common::String(g_director->getGameId()).equals("trektech") &&
+			castInfo && castInfo->name.equalsIgnoreCase("BltIndex Window");
 	Graphics::MacText *target = getWidget();
 	if (target) {
+		// IndexMaker asks for this cast's textHeight while it is being
+		// constructed, before its runtime globals or Index-active flag exist.
+		// The original projector returns the complete row height here.
+		if (trekIndexField && target->getRowCount() > 0)
+			return target->getLineHeight(0);
+
 		return target->getLineSpacing();
 	}
+	if (trekIndexField) {
+		Graphics::MacFont macFont(_fontId, _fontSize, _textSlant);
+		const Graphics::Font *font = g_director->_wm->_fontMan->getFont(macFont);
+		if (font)
+			return font->getFontHeight();
+	}
 	return _lineSpacing;
 }
 
diff --git a/engines/director/window.cpp b/engines/director/window.cpp
--- a/engines/director/window.cpp
+++ b/engines/director/window.cpp
@@ -50,6 +50,15 @@ bool commandsWindowCallback(Graphics::WindowClick click, Common::Event &event, v
 	return w->processWMEvent(click, event);
 }
 
+static bool isTrekTechHelpTextChannel(Channel *channel) {
+	if (!channel || !channel->_sprite || !channel->_sprite->_cast ||
+			!Common::String(g_director->getGameId()).equals("trektech"))
+		return false;
+
+	CastMemberInfo *castInfo = channel->_sprite->_cast->getInfo();
+	return castInfo && castInfo->name.equalsIgnoreCase("TheHelpTextWin");
+}
+
 Window::Window(int id, bool scrollable, bool resizable, bool editable, Graphics::MacWindowManager *wm, DirectorEngine *vm, bool isStage)
 : Object<Window>("Window") {
 	_vm = vm;
@@ -328,6 +337,11 @@ bool Window::render(bool forceRedraw, Graphics::ManagedSurface *blitTo) {
 		if (!chan->_needsDraw && !forceRedraw)
 			continue;
 		Common::Rect bbox = chan->getBbox();
+		// Trek Tech's Help text widget is wider than its score sprite. Extend
+		// only this render pass; the channel's authored geometry remains intact
+		// for hit testing, intersections, and subsequent screen lifecycles.
+		if (isTrekTechHelpTextChannel(chan) && chan->_widget)
+			bbox = chan->_widget->getDimensions();
 
 		debugC(7, kDebugImages, "Window::render(): drawing channel %d", (int)i);
 
@@ -533,6 +547,8 @@ void Window::reset() {
 
 void Window::inkBlitFrom(Channel *channel, Common::Rect destRect, Graphics::ManagedSurface *blitTo) {
 	Common::Rect srcRect = channel->getBbox();
+	if (isTrekTechHelpTextChannel(channel) && channel->_widget)
+		srcRect = channel->_widget->getDimensions();
 	destRect.clip(srcRect);
 
 	DirectorPlotData pd = channel->getPlotData();
