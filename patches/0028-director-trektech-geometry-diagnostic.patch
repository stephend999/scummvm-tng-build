From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: log Trek Tech UI geometry

This diagnostic patch makes no rendering or input changes. It records the
actual rectangles used by the embedded plan movie, Index text widget, and
Help text field so the next corrective patch can be based on measured
geometry rather than inferred screen positions.
---
 engines/director/castmember/text.cpp |  8 ++++++++
 engines/director/lingo/lingo-the.cpp | 23 +++++++++++++++++++++++
 engines/director/window.cpp          | 13 +++++++++++++
 3 files changed, 44 insertions(+)

diff --git a/engines/director/castmember/text.cpp b/engines/director/castmember/text.cpp
--- a/engines/director/castmember/text.cpp
+++ b/engines/director/castmember/text.cpp
@@ -302,6 +302,14 @@ Graphics::MacWidget *TextCastMember::createWindowOrWidget(Common::Rect &bbox, Co
 
 	int maxWidth = _initialRect.width() + _borderSize * 2 + _gutterSize * 2 + _boxShadow;
 	CastMemberInfo *castInfo = _cast->getCastMemberInfo(_castId);
+	if (Common::String(g_director->getGameId()).equals("trektech") && castInfo &&
+			castInfo->name.equalsIgnoreCase("TheHelpTextWin")) {
+		warning("TNG-GEOMETRY help cast=%d bbox=(%d,%d,%d,%d) dims=(%d,%d,%d,%d) initial=(%d,%d,%d,%d) maxWidth=%d type=%d border=%d gutter=%d shadow=%d",
+				_castId, bbox.left, bbox.top, bbox.right, bbox.bottom,
+				dims.left, dims.top, dims.right, dims.bottom,
+				_initialRect.left, _initialRect.top, _initialRect.right, _initialRect.bottom,
+				maxWidth, _textType, _borderSize, _gutterSize, _boxShadow);
+	}
 	// Trek Tech displays its Help explanation field wider than the cast
