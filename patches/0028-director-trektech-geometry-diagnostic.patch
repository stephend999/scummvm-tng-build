+						channel->_lastRenderedBbox.left, channel->_lastRenderedBbox.top,
+						channel->_lastRenderedBbox.right, channel->_lastRenderedBbox.bottom,
+						channel->hasSubChannels());
+			}
 			channel->_visible = (bool)d.asInt();
 			channel->setNeedsDraw();
 		}
