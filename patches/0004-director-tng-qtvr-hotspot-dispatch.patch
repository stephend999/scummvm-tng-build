From: TNG Technical Manual compatibility investigation
Subject: [PATCH 4/4] DIRECTOR: Dispatch TNG QTVR object hotspots

The Windows TNG Technical Manual calls QTVR mouseOver as a Director 4 command.
After the XObject identifies an object hotspot, call the title's original
hotHitReport handler to populate its hotspot state and then hotHitPlay to load
the corresponding CD playlist.
---
 engines/director/lingo/xlibs/q/qtvr.cpp | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/engines/director/lingo/xlibs/q/qtvr.cpp b/engines/director/lingo/xlibs/q/qtvr.cpp
index 42e45dfb..e039ca7a 100644
--- a/engines/director/lingo/xlibs/q/qtvr.cpp
+++ b/engines/director/lingo/xlibs/q/qtvr.cpp
@@ -261,8 +261,25 @@ void QTVR::m_mouseOver(int nargs) {
 
 				if (nodeChanged || (hotspotData && hotspotData->type == MKTAG('l','i','n','k')))
 					g_lingo->push(Common::String::format("jump,%d", node));
-				else
+				else {
+					// The TNG Technical Manual's Director 4 bytecode invokes mouseOver
+					// as a command, then dispatches the selected object through its movie
+					// handlers. Report the hotspot first so the title can populate
+					// prevIndex/validSpotFlag, then run the original playback handler.
+					// This avoids losing the command result across the nested rollover
+					// callback.
+					if (Common::String(g_director->getGameId()).equals("trektech")) {
+						int cframe = g_lingo->_state->callstack.size();
+						g_lingo->push(Datum(hotspot));
+						LC::call("hotHitReport", 1, false);
+						g_lingo->execute(cframe);
+
+						cframe = g_lingo->_state->callstack.size();
+						LC::call("hotHitPlay", 0, false);
+						g_lingo->execute(cframe);
+					}
 					g_lingo->push(Common::String::format("%s,%d", hotspotData ? tag2str((uint32)hotspotData->type) : "undf", hotspot));
+				}
 
 				return;
 			}
