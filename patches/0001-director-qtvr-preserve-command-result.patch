From: TNG Technical Manual compatibility investigation
Subject: [PATCH 1/4] DIRECTOR: Preserve legacy XObject command result

Some Director 4 XObjects return a value from a command-style call and scripts
read it immediately through `the result`. Preserve the QTVR mouseOver value in
a one-shot slot so nested callbacks cannot replace it before bytecode resumes.
---
 engines/director/lingo/lingo-code.cpp | 5 +++++
 engines/director/lingo/lingo-the.cpp  | 7 ++++++-
 engines/director/lingo/lingo.h        | 5 +++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/engines/director/lingo/lingo-code.cpp b/engines/director/lingo/lingo-code.cpp
index db6ff976..4c69e4c2 100644
--- a/engines/director/lingo/lingo-code.cpp
+++ b/engines/director/lingo/lingo-code.cpp
@@ -1852,6 +1852,11 @@ void LC::call(const Symbol &funcSym, int nargs, bool allowRetVal) {
 			if (stackSize == stackSizeBefore + 1) {
 				if (!allowRetVal) {
 					Datum extra = g_lingo->pop();
+					if (extra.type != VOID && funcSym.name && funcSym.name->equalsIgnoreCase("mouseOver")) {
+						g_lingo->_theResult = extra;
+						g_lingo->_pendingCommandResult = extra;
+						g_lingo->_hasPendingCommandResult = true;
+					}
 					warning("Builtin '%s' dropping return value: %s", funcSym.name->c_str(), extra.asString(true).c_str());
 				}
 			} else if (stackSize == stackSizeBefore) {
diff --git a/engines/director/lingo/lingo-the.cpp b/engines/director/lingo/lingo-the.cpp
index 1ec91626..f18f3ff6 100644
--- a/engines/director/lingo/lingo-the.cpp
+++ b/engines/director/lingo/lingo-the.cpp
@@ -1013,7 +1013,12 @@ Datum Lingo::getTheEntity(int entity, Datum &id, int field) {
 		d = (int)g_director->_rnd.getSeed();
 		break;
 	case kTheResult:
-		d = g_lingo->_theResult;
+		if (g_lingo->_hasPendingCommandResult) {
+			d = g_lingo->_pendingCommandResult;
+			g_lingo->_hasPendingCommandResult = false;
+		} else {
+			d = g_lingo->_theResult;
+		}
 		break;
 	case kTheRightMouseDown:
 		if (Director::DT::isMouseInputIgnored()) {
diff --git a/engines/director/lingo/lingo.h b/engines/director/lingo/lingo.h
index d80362d9..88119777 100644
--- a/engines/director/lingo/lingo.h
+++ b/engines/director/lingo/lingo.h
@@ -577,6 +577,11 @@ public:
 	int _floatPrecision;
 
 	Datum _theResult;
+	// Some legacy XObjects return a value from a command-style call. Keep that
+	// value until the following `the result` read; nested callbacks can otherwise
+	// replace the ordinary result slot before bytecode resumes.
+	Datum _pendingCommandResult;
+	bool _hasPendingCommandResult = false;
 
 	// events
 	bool _passEvent;
-- 
