From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: Normalize Trek Tech article formatting markers

Trek Tech text files contain legacy formatting bytes which the Windows Trek
font renders as visible punctuation under ScummVM. Normalize them at read
time while preserving the original disc data: hide leading 0xA5 markers,
translate Mac Roman spacing and punctuation into display-safe ASCII, and hide
the end-of-article marker only when it is the final non-whitespace byte.
---
 engines/director/lingo/xlibs/f/fileio.cpp | 45 +++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 45 insertions(+)

diff --git a/engines/director/lingo/xlibs/f/fileio.cpp b/engines/director/lingo/xlibs/f/fileio.cpp
index 76a2cccf..c7bbb7cf 100644
--- a/engines/director/lingo/xlibs/f/fileio.cpp
+++ b/engines/director/lingo/xlibs/f/fileio.cpp
@@ -555,6 +555,51 @@ void FileIO::m_readFile(int nargs) {
 		ch = me->_inStream->readByte();
 	}
 
+	// Trek Tech article text contains legacy formatting bytes that the bundled
+	// Windows font renders as visible punctuation. Normalize them only while
+	// reading this title, leaving the original disc data untouched.
+	if (Common::String(g_director->getGameId()).equals("trektech")) {
+		for (uint i = 0; i < res.size();) {
+			const bool lineStart = i == 0 || res[i - 1] == '\r' || res[i - 1] == '\n';
+			const byte currentByte = (byte)res[i];
+
+			if (currentByte == 0xA5 && lineStart) {
+				res.deleteChar(i);
+				continue;
+			}
+
+			if ((currentByte == '\t' && lineStart) || currentByte == 0xCA)
+				res.setChar(' ', i);
+			else if (currentByte == 0xC9) {
+				// Preserve the meaning of the Mac Roman ellipsis with three
+				// characters that the bundled Windows font can display.
+				res.setChar('.', i);
+				res.insertChar('.', i + 1);
+				res.insertChar('.', i + 2);
+				i += 3;
+				continue;
+			} else if (currentByte == 0xD0 || currentByte == 0xD1) {
+				res.setChar('-', i);
+			} else if (currentByte == 0xD2 || currentByte == 0xD3) {
+				res.setChar('"', i);
+			} else if (currentByte == 0xD4 || currentByte == 0xD5) {
+				res.setChar('\'', i);
+			}
+			++i;
+		}
+
+		// 0xC6 is the end-of-article marker. Remove it only when all following
+		// bytes are whitespace so a future legitimate in-text byte is preserved.
+		for (int i = (int)res.size() - 1; i >= 0; --i) {
+			const byte currentByte = (byte)res[i];
+			if (currentByte == ' ' || currentByte == '\t' || currentByte == '\r' || currentByte == '\n')
+				continue;
+			if (currentByte == 0xC6)
+				res.deleteChar(i);
+			break;
+		}
+	}
+
 	g_lingo->push(res);
 }
 
