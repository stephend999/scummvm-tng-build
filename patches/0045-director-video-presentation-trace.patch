From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: trace transit video presentation stages

Add opt-in pixel fingerprints after transit frame decoding, after Director
compositing, and after window-manager presentation. BlankQT is excluded so
the diagnostic remains small and minimally affects playback timing.
---
 engines/director/castmember/digitalvideo.cpp | 22 ++++++++++++
 engines/director/graphics.cpp                | 49 +++++++++++++++++++++++++++
 engines/director/window.cpp                  | 29 ++++++++++++++++
 3 files changed, 100 insertions(+)

diff --git a/engines/director/castmember/digitalvideo.cpp b/engines/director/castmember/digitalvideo.cpp
--- a/engines/director/castmember/digitalvideo.cpp
+++ b/engines/director/castmember/digitalvideo.cpp
@@ -47,6 +47,20 @@
 
 namespace Director {
 
+static uint32 hashTrekVideoSurface(const Graphics::Surface *surface) {
+	if (!surface || !surface->getPixels() || surface->w <= 0 || surface->h <= 0)
+		return 0;
+
+	uint32 hash = 2166136261U;
+	const int rowBytes = surface->w * surface->format.bytesPerPixel;
+	for (int y = 0; y < surface->h; ++y) {
+		const byte *row = (const byte *)surface->getBasePtr(0, y);
+		for (int x = 0; x < rowBytes; ++x)
+			hash = (hash ^ row[x]) * 16777619U;
+	}
+	return hash;
+}
+
 
 class NoVideoAIFFDecoder : public Video::VideoDecoder {
 
@@ -601,6 +615,14 @@ Graphics::MacWidget *DigitalVideoCastMember::createWidget(Common::Rect &bbox, Ch
 			bbox
 		);
 
+	if (ConfMan.getBool("tng_video_lifecycle_trace") &&
+			!_filename.hasSuffixIgnoreCase("BlankQT.mov")) {
+		warning("TNG_VIDEO_PIPE stage=decode file=%s nowMs=%u curFrame=%d sourceHash=%08x cachedHash=%08x widgetHash=%08x",
+				_filename.c_str(), _video->getTime(), _video->getCurFrame(),
+				hashTrekVideoSurface(frame), hashTrekVideoSurface(_lastFrame),
+				hashTrekVideoSurface(widget->getSurface()));
+	}
+
 	if (_getFirstFrame) {
 		_video->stop();
 		_getFirstFrame = false;
