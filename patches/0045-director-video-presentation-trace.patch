 namespace Director {
 
+static uint32 hashTrekPresentedRect(Graphics::ManagedSurface *surface, Common::Rect area) {
+	if (!surface || !surface->getPixels())
+		return 0;
+
+	area.clip(surface->getBounds());
+	if (area.isEmpty())
+		return 0;
+
+	uint32 hash = 2166136261U;
+	const int bytesPerPixel = surface->format.bytesPerPixel;
+	for (int y = area.top; y < area.bottom; ++y) {
+		const byte *row = (const byte *)surface->getBasePtr(area.left, y);
+		for (int x = 0; x < area.width() * bytesPerPixel; ++x)
+			hash = (hash ^ row[x]) * 16777619U;
+	}
+	return hash;
+}
+
 #include "director/graphics-data.h"
 
 /**
@@ -287,6 +310,32 @@ void DirectorEngine::setCursor(DirectorCursor type) {
 void DirectorEngine::draw() {
 	_wm->renderZoomBox(true);
 	_wm->draw();
+
+	if (ConfMan.getBool("tng_video_lifecycle_trace") &&
+			Common::String(getGameId()).equals("trektech") && _stage &&
+			_stage->getCurrentMovie()) {
+		Score *score = _stage->getCurrentMovie()->getScore();
+		Channel *channel = score ? score->getChannelById(23) : nullptr;
+		if (channel && channel->_sprite && channel->_sprite->_cast &&
+				channel->_sprite->_cast->_type == kCastDigitalVideo) {
+			DigitalVideoCastMember *video = (DigitalVideoCastMember *)channel->_sprite->_cast;
+			if (!video->_filename.hasSuffixIgnoreCase("BlankQT.mov") && channel->isActiveVideo()) {
+				static Common::String lastFile;
+				static uint32 lastHash = 0;
+				static uint32 lastReportMs = 0;
+				const uint32 hash = hashTrekPresentedRect(_surface, channel->getBbox());
+				const uint32 nowMs = g_system->getMillis();
+				if (video->_filename != lastFile || hash != lastHash || nowMs - lastReportMs >= 500) {
+					warning("TNG_VIDEO_PIPE stage=present file=%s now=%d presentHash=%08x bbox=%d,%d,%d,%d",
+							video->_filename.c_str(), video->getMovieCurrentTime(), hash,
+							PRINT_RECT(channel->getBbox()));
+					lastFile = video->_filename;
+					lastHash = hash;
+					lastReportMs = nowMs;
+				}
+			}
+		}
+	}
 	g_system->updateScreen();
 }
 
