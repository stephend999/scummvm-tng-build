From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: defer Trek Tech Help plan cleanup

Trek Tech uses sprite 20 for the raised Help floor plan, then immediately
reuses that channel as a one-pixel trail sprite when returning to the page.
The old Help rectangle is therefore lost before it can be invalidated, and
its pixels remain above the restored page plan.

Remember HELP20's authored rectangle when goHelp completes.  When goBackHelp
finishes, queue that rectangle on the Director window without drawing during
Lingo stack unwinding.  The next ordinary render pass recomposes only the
saved rectangle through the restored non-trail plan channel.  This preserves
the title's intentional menu trails and avoids both re-entrant rendering and
a full-screen redraw.
---
 engines/director/lingo/lingo-code.cpp | 40 +++++++++++++++++++++++++++
 engines/director/window.cpp           | 11 ++++++++
 engines/director/window.h             |  2 ++
 3 files changed, 53 insertions(+)

diff --git a/engines/director/lingo/lingo-code.cpp b/engines/director/lingo/lingo-code.cpp
index 4c69e4c2..e9293b02 100644
--- a/engines/director/lingo/lingo-code.cpp
+++ b/engines/director/lingo/lingo-code.cpp
@@ -60,6 +60,40 @@
 
 namespace Director {
 
+static Common::Rect g_trekHelpPlanRect;
+
+static void handleTrekHelpPlanCleanup(const char *phase, const Common::String &handler) {
+	if (strcmp(g_director->getGameId(), "trektech") != 0)
+		return;
+
+	if (handler.equalsIgnoreCase("goHelp") && !strcmp(phase, "call")) {
+		g_trekHelpPlanRect = Common::Rect();
+		return;
+	}
+
+	const bool helpEntered = handler.equalsIgnoreCase("goHelp") && !strcmp(phase, "return");
+	const bool helpExited = handler.equalsIgnoreCase("goBackHelp") && !strcmp(phase, "return");
+	if (!helpEntered && !helpExited)
+		return;
+
+	Movie *movie = g_director->getCurrentMovie();
+	if (!movie || !movie->getScore())
+		return;
+
+	if (helpEntered) {
+		Channel *helpPlan = movie->getScore()->getChannelById(20);
+		CastMemberInfo *castInfo = helpPlan && helpPlan->_sprite && helpPlan->_sprite->_cast ? helpPlan->_sprite->_cast->getInfo() : nullptr;
+		if (castInfo && castInfo->name.equalsIgnoreCase("HELP20"))
+			g_trekHelpPlanRect = helpPlan->getBbox();
+		return;
+	}
+
+	Window *window = g_director->getCurrentWindow();
+	if (!g_trekHelpPlanRect.isEmpty() && window)
+		window->scheduleTrekHelpPlanCleanup(g_trekHelpPlanRect);
+	g_trekHelpPlanRect = Common::Rect();
+}
+
 static const struct FuncDescr {
 	const inst func;
 	const char *name;
@@ -379,6 +413,9 @@ void Lingo::popContext(bool aborting) {
 
 	// Undo the pushContext window switch.
 	Window *retWindow = fp->retWindow;
+	Common::String completedHandler = fp->sp.name ? *fp->sp.name : Common::String();
+	if (completedHandler.equalsIgnoreCase("goHelp") || completedHandler.equalsIgnoreCase("goBackHelp"))
+		handleTrekHelpPlanCleanup("return", completedHandler);
 
 	delete fp;
 
@@ -1645,6 +1682,9 @@ void LC::c_callfunc() {
 }
 
 void LC::call(const Common::String &name, int nargs, bool allowRetVal) {
+	if (name.equalsIgnoreCase("goHelp") || name.equalsIgnoreCase("goBackHelp"))
+		handleTrekHelpPlanCleanup("call", name);
+
 	if (debugChannelSet(3, kDebugLingoExec))
 		g_lingo->printArgs(name.c_str(), nargs, "call:");
 
diff --git a/engines/director/window.cpp b/engines/director/window.cpp
index f393689e..d2aea87b 100644
--- a/engines/director/window.cpp
+++ b/engines/director/window.cpp
@@ -447,6 +447,17 @@ bool Window::render(bool forceRedraw, Graphics::ManagedSurface *blitTo) {
 		chan->_lastTrail = chan->isTrail();
 	}
 
+	// Trek Tech reuses Help's raised floor-plan channel as a one-pixel trail
+	// sprite before the old rectangle can be invalidated.  Recompose the saved
+	// rectangle only after Lingo has returned and normal rendering is underway.
+	if (isTrekTech && !_trekHelpPlanCleanupRect.isEmpty()) {
+		Common::Rect cleanupRect = _trekHelpPlanCleanupRect;
+		_trekHelpPlanCleanupRect = Common::Rect();
+		Channel *restoredPlan = score->getChannelById(18);
+		if (restoredPlan && restoredPlan->_sprite && !restoredPlan->isTrail())
+			renderChannel(restoredPlan, cleanupRect, blitTo);
+	}
+
 	Common::List<Common::Rect> &dirtyRects = _window->getDirtyRectList();
 
 	// Trek Tech's Help exit leaves stale pixels in the presentation buffer,
diff --git a/engines/director/window.h b/engines/director/window.h
index 3c371d48..abcc6495 100644
--- a/engines/director/window.h
+++ b/engines/director/window.h
@@ -157,6 +157,7 @@ public:
 	void setTitleVisible(bool titleVisible);
 	Graphics::ManagedSurface *getSurface();
 	void addDirtyRect(const Common::Rect &r);
+	void scheduleTrekHelpPlanCleanup(const Common::Rect &r) { _trekHelpPlanCleanupRect = r; }
 	void resizeInner(int w, int h);
 	int getId();
 	void setDirty(bool dirty);
@@ -255,6 +256,7 @@ private:
 	// overlapping frame sprite's later QTVR redraw.
 	Common::Rect _trekMenuTrailBounds;
 	bool _trekHelpPlanCleanupPending;
+	Common::Rect _trekHelpPlanCleanupRect;
 	uint32 _stageColor;
 	void traceTrekHelpPlanSurfaces(uint frameNum, Graphics::ManagedSurface *stageSurface);
 
