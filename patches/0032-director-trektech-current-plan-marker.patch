From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: refresh Trek Tech floor plan without frame lag

Trek Tech changes gNodeNow and redraws its host frame immediately.  Its
embedded floor-plan movie normally honours its own next-frame deadline, so
the exitFrame handler that reads gNodeNow can be deferred until the following
host redraw.  The location marker consequently remains one navigation step
behind.

Only for Trek Tech's authored floor-plan sprite 18, allow the embedded movie
to process its scripted frame on the current host redraw.  Other movie cast
members, transit video, and normal Director timing remain unchanged.
---
 engines/director/castmember/movie.cpp | 5 ++++-
 engines/director/castmember/movie.h   | 2 +-
 engines/director/score.cpp            | 4 +++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/engines/director/castmember/movie.cpp b/engines/director/castmember/movie.cpp
--- a/engines/director/castmember/movie.cpp
+++ b/engines/director/castmember/movie.cpp
@@ -170,7 +170,7 @@ void MovieCastMember::load() {
 	}
 }
 
-void MovieCastMember::update() {
+void MovieCastMember::update(bool immediate) {
 	if (!_loaded)
 		load();
 	if (!_linkedMovie)
@@ -181,6 +181,9 @@ void MovieCastMember::update() {
 	// drawing to the host window; the host composites them via getSubChannels().
 	Score *score = _linkedMovie->getScore();
 
+	if (immediate)
+		score->_nextFrameTime = 0;
+
 	// Scripts resolve context via getCurrentMovie(), so point the shared
 	// window at the linked movie for the step, then restore. This lets its
 	// go()/globals/events act on itself.
diff --git a/engines/director/castmember/movie.h b/engines/director/castmember/movie.h
--- a/engines/director/castmember/movie.h
+++ b/engines/director/castmember/movie.h
@@ -43,7 +43,7 @@ public:
 	Datum getField(int field) override;
 	void setField(int field, const Datum &value) override;
 
-	void update();
+	void update(bool immediate = false);
 
 	// Map a host-stage mouse position into the linked movie's space and
 	// queue the event for its scripts to handle on the next step.
diff --git a/engines/director/score.cpp b/engines/director/score.cpp
--- a/engines/director/score.cpp
+++ b/engines/director/score.cpp
@@ -947,7 +947,9 @@ void Score::incrementFilmLoops() {
 		if (type == kCastMovie) {
 			// A movie cast member steps its own embedded score like a normal
 			// movie, not the film loop flipbook.
-			((MovieCastMember *)it->_sprite->_cast)->update();
+			bool immediateTrekPlan = Common::String(g_director->getGameId()).equals("trektech") &&
+					it == getChannelById(18);
+			((MovieCastMember *)it->_sprite->_cast)->update(immediateTrekPlan);
 		} else if (type == kCastFilmLoop && !filmLoopsFrozen) {
 			FilmLoopCastMember *fl = ((FilmLoopCastMember *)it->_sprite->_cast);
 			if (fl->_score && !fl->_score->_scoreCache.empty()) {
