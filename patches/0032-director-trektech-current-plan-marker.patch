From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: composite the current Trek Tech plan marker

Trek Tech updates gNodeNow during the host frame's exitFrame handler.  The
embedded floor plan was advanced after updateSprites() had already copied its
subchannels, so the stage composited the preceding node marker until another
host redraw.

For Trek Tech's floor-plan sprite 18 only, advance its embedded movie before
updateSprites() takes that snapshot.  Skip its usual later movie-cast update
so it still advances exactly once.  Other embedded movies, film loops,
transit video, and rendering order remain unchanged.
---
 engines/director/score.cpp | 20 +++++++++++++++++---
 engines/director/score.h   |  2 +-
 2 files changed, 18 insertions(+), 4 deletions(-)

diff --git a/engines/director/score.cpp b/engines/director/score.cpp
--- a/engines/director/score.cpp
+++ b/engines/director/score.cpp
@@ -884,8 +884,21 @@ void Score::renderFrame(uint16 frameId, RenderMode mode, bool sound1Changed, boo
 	} else if (!renderTransition(frameId, mode)) {
 		bool skip = renderPrePaletteCycle(mode);
 		setLastPalette();
+
+		// Trek Tech's scripted floor plan must advance before updateSprites()
+		// snapshots its embedded subchannels. Otherwise the stage composites
+		// the marker from the preceding QTVR node until the next host redraw.
+		bool updatedTrekPlan = false;
+		if (Common::String(g_director->getGameId()).equals("trektech")) {
+			Channel *plan = getChannelById(18);
+			if (plan && plan->_sprite && plan->_sprite->_cast && plan->_sprite->_cast->_type == kCastMovie) {
+				((MovieCastMember *)plan->_sprite->_cast)->update();
+				updatedTrekPlan = true;
+			}
+		}
+
 		updateSprites(mode);
-		incrementFilmLoops();
+		incrementFilmLoops(updatedTrekPlan);
 		_window->render();
 		if (!skip)
 			renderPaletteCycle(mode);
@@ -928,7 +941,7 @@ bool Score::renderTransition(uint16 frameId, RenderMode mode) {
 }
 
 // increment filmloops or movie cast members
-void Score::incrementFilmLoops() {
+void Score::incrementFilmLoops(bool skipTrekPlan) {
 	// Film loops do not advance while the movie is paused
 	if (_window->_playbackPaused)
 		return;
@@ -948,7 +961,8 @@ void Score::incrementFilmLoops() {
 		if (type == kCastMovie) {
 			// A movie cast member steps its own embedded score like a normal
 			// movie, not the film loop flipbook.
-			((MovieCastMember *)it->_sprite->_cast)->update();
+			if (!(skipTrekPlan && it == getChannelById(18)))
+				((MovieCastMember *)it->_sprite->_cast)->update();
 		} else if (type == kCastFilmLoop && !filmLoopsFrozen) {
 			FilmLoopCastMember *fl = ((FilmLoopCastMember *)it->_sprite->_cast);
 			if (fl->_score && !fl->_score->_scoreCache.empty()) {
diff --git a/engines/director/score.h b/engines/director/score.h
--- a/engines/director/score.h
+++ b/engines/director/score.h
@@ -129,7 +129,7 @@ public:
 
 	bool renderTransition(uint16 frameId, RenderMode mode);
 	void renderFrame(uint16 frameId, RenderMode mode = kRenderModeNormal, bool sound1Changed = true, bool sound2Changed = true);
-	void incrementFilmLoops();
+	void incrementFilmLoops(bool skipTrekPlan = false);
 	void updateSprites(RenderMode mode = kRenderModeNormal, bool withClean = false);
 	bool renderPrePaletteCycle(RenderMode mode = kRenderModeNormal);
 	void setLastPalette();
