From: TNG Technical Manual compatibility investigation
Subject: [PATCH] DIRECTOR: trace late Help-plan restoration

Diagnostic only.  The Help floor-plan remnant is absent from the Director
stage surface immediately after Help exits, but appears in ScummVM's saved
output and returns after Index restores the Bridge page.  Beginning at the
authored Help-exit frame, keep process-level trace state across replacement
Director windows and hash the exact visible remnant strip in both the stage
surface and the Mac window-manager composite.  Report only pixel or surface
changes so the first layer and score frame that restores the pixels can be
identified without altering drawing, input, timing, or gameplay state.
---
 engines/director/window.cpp | 65 +++++++++++++++++++++++++++++++++++++
 engines/director/window.h   |  1 +
 2 files changed, 66 insertions(+)

diff --git a/engines/director/window.cpp b/engines/director/window.cpp
--- a/engines/director/window.cpp
+++ b/engines/director/window.cpp
@@ -57,10 +57,39 @@ static bool isTrekTechHelpTextChannel(Channel *channel) {
 
 	CastMemberInfo *castInfo = channel->_sprite->_cast->getInfo();
 	return castInfo && castInfo->name.equalsIgnoreCase("TheHelpTextWin");
 }
 
+static bool g_trekHelpPlanTraceActive = false;
+static bool g_trekHelpPlanStageHashValid = false;
+static bool g_trekHelpPlanCompositeHashValid = false;
+static uint32 g_trekHelpPlanStageHash = 0;
+static uint32 g_trekHelpPlanCompositeHash = 0;
+static Graphics::ManagedSurface *g_trekHelpPlanStageSurface = nullptr;
+static Graphics::ManagedSurface *g_trekHelpPlanCompositeSurface = nullptr;
+
+static uint32 hashTrekHelpPlanRemnant(Graphics::ManagedSurface *surface, uint32 stageColor,
+		uint32 &nonStagePixels) {
+	if (!surface) {
+		nonStagePixels = 0;
+		return 0;
+	}
+
+	Common::Rect area(472, 334, 596, 347);
+	area.clip(surface->getBounds());
+	uint32 hash = 2166136261U;
+	nonStagePixels = 0;
+	for (int y = area.top; y < area.bottom; ++y) {
+		for (int x = area.left; x < area.right; ++x) {
+			const uint32 pixel = surface->getPixel(x, y);
+			nonStagePixels += pixel != stageColor;
+			hash = (hash ^ pixel) * 16777619U;
+		}
+	}
+	return hash;
+}
+
 Window::Window(int id, bool scrollable, bool resizable, bool editable, Graphics::MacWindowManager *wm, DirectorEngine *vm, bool isStage)
 : Object<Window>("Window") {
 	_vm = vm;
 	_wm = wm;
 	_isStage = isStage;
@@ -92,10 +121,34 @@ Window::Window(int id, bool scrollable, bool resizable, bool editable, Graphics:
 	_window->setCallback(commandsWindowCallback, this);
 
 	updateBorderType();
 }
 
+void Window::traceTrekHelpPlanSurfaces(uint frameNum, Graphics::ManagedSurface *stageSurface) {
+	uint32 nonStagePixels = 0;
+	const uint32 stageHash = hashTrekHelpPlanRemnant(stageSurface, _stageColor, nonStagePixels);
+	if (!g_trekHelpPlanStageHashValid || stageHash != g_trekHelpPlanStageHash ||
+			stageSurface != g_trekHelpPlanStageSurface) {
+		warning("TNG-HELP-RESTORE layer=stage frame=%u hash=%08x nonStage=%u window=%p surface=%p",
+				frameNum, stageHash, nonStagePixels, (void *)this, (void *)stageSurface);
+		g_trekHelpPlanStageHash = stageHash;
+		g_trekHelpPlanStageSurface = stageSurface;
+		g_trekHelpPlanStageHashValid = true;
+	}
+
+	Graphics::ManagedSurface *compositeSurface = _wm->_screen;
+	const uint32 compositeHash = hashTrekHelpPlanRemnant(compositeSurface, _stageColor, nonStagePixels);
+	if (!g_trekHelpPlanCompositeHashValid || compositeHash != g_trekHelpPlanCompositeHash ||
+			compositeSurface != g_trekHelpPlanCompositeSurface) {
+		warning("TNG-HELP-RESTORE layer=composite frame=%u hash=%08x nonStage=%u window=%p surface=%p",
+				frameNum, compositeHash, nonStagePixels, (void *)this, (void *)compositeSurface);
+		g_trekHelpPlanCompositeHash = compositeHash;
+		g_trekHelpPlanCompositeSurface = compositeSurface;
+		g_trekHelpPlanCompositeHashValid = true;
+	}
+}
+
 Window::~Window() {
 	delete _lingoState;
 	if (_lingoPlayState)
 		delete _lingoPlayState;
 	delete _soundManager;
@@ -400,16 +453,28 @@ bool Window::render(bool forceRedraw, Graphics::ManagedSurface *blitTo) {
 	// although the persistent window surface is already correct.  Frame 942
 	// begins the exit; wait for the returned page to settle, then refresh the
 	// display from that surface without redrawing its historical trail sprites.
 	if (isTrekTech && score->getCurrentFrameNum() == 942) {
 		_trekHelpPlanCleanupPending = true;
+		if (!g_trekHelpPlanTraceActive) {
+			g_trekHelpPlanTraceActive = true;
+			g_trekHelpPlanStageHashValid = false;
+			g_trekHelpPlanCompositeHashValid = false;
+			g_trekHelpPlanStageSurface = nullptr;
+			g_trekHelpPlanCompositeSurface = nullptr;
+			warning("TNG-HELP-RESTORE trace-start frame=%u area=472,334,596,347",
+					score->getCurrentFrameNum());
+		}
 	} else if (isTrekTech && _trekHelpPlanCleanupPending && dirtyRects.empty()) {
 		_wm->setFullRefresh(true);
 		_window->setContentDirty(true);
 		_trekHelpPlanCleanupPending = false;
 	}
 
+	if (isTrekTech && g_trekHelpPlanTraceActive)
+		traceTrekHelpPlanSurfaces(score->getCurrentFrameNum(), blitTo);
+
 	if (forceRedraw) {
 		_window->markAllDirty();
 	} else {
 		if (dirtyRects.size() == 0 && _currentMovie->_videoPlayback == false) {
 			if (g_director->_debugDraw & kDebugDrawFrame) {
diff --git a/engines/director/window.h b/engines/director/window.h
--- a/engines/director/window.h
+++ b/engines/director/window.h
@@ -254,10 +254,11 @@ private:
 	// have no live sprites after menu construction and must survive the
 	// overlapping frame sprite's later QTVR redraw.
 	Common::Rect _trekMenuTrailBounds;
 	bool _trekHelpPlanCleanupPending;
 	uint32 _stageColor;
+	void traceTrekHelpPlanSurfaces(uint frameNum, Graphics::ManagedSurface *stageSurface);
 
 	DirectorEngine *_vm;
 	DirectorSound *_soundManager;
 	LingoState *_lingoState;
 	Common::Array<LingoState *> _frozenLingoStates;
